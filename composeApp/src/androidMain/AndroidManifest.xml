<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpaceLaunchNow">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:theme="@style/Theme.SpaceLaunchNow"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links from Wear OS companion app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="spacelaunchnow" />
            </intent-filter>
        </activity>

        <service
            android:name=".services.SpaceLaunchFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Next Up Widget -->
        <receiver
            android:name=".widgets.NextUpWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_up_widget_info" />
        </receiver>
        
        <!-- AdMob App ID (set via ADMOB_APP_ID in .env; debug builds use Google's test App ID) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Resolve AdServices config conflict -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <!-- Launch List Widget -->
        <receiver
            android:name=".widgets.LaunchListWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/launch_list_widget_info" />
        </receiver>

        <!-- Phone-side DataLayer listener for watch sync requests -->
        <service
            android:name=".sync.PhoneDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/spacelaunchnow/request-sync"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Opt out of WorkManager's androidx.startup auto-initialization.
             WorkManagerInitializer runs inside InitializationProvider.onCreate(), so any
             throwable it raises kills the process during content-provider install, before
             a single line of app code runs (issue #181: JobScheduler34.forNamespace() is
             missing on some non-conforming API 34 firmware, producing a NoSuchMethodError).
             MainApplication implements Configuration.Provider instead, so WorkManager
             initializes on demand at the first WorkManager.getInstance() call, where the
             failure is catchable and degrades to "no background work" rather than a crash.

             tools:node="merge" keeps the shared InitializationProvider declaration alive for
             every other androidx.startup initializer (emoji2, ProcessLifecycleInitializer,
             ProfileInstaller) and removes only WorkManager's meta-data entry. The authority
             and android:exported must match the library declaration exactly, otherwise the
             manifest merger adds a second provider instead of merging into the existing one
             and auto-init is silently reinstated. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>