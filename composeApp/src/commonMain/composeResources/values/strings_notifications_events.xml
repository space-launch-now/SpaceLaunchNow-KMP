    <!-- Screen title in the top bar of the notification settings screen. One line. -->
    <string name="notification_settings_title">Notification Filters</string>
    <!-- Heading of the warning card shown when the system notification permission is off. One line. -->
    <string name="notification_settings_disabled_title">Notifications Disabled</string>
    <!-- Text in the warning card shown when the system notification permission is off. One or two lines. -->
    <string name="notification_settings_disabled_message">Enable notifications to receive launch alerts.</string>
    <!-- Button in the warning card. Asks the system for the notification permission. One word, max 14 chars. -->
    <string name="notification_settings_enable_button">Enable</string>
    <!-- Button in the warning card. Opens the system settings screen for the app. Max 14 chars. -->
    <string name="notification_settings_open_settings_button">Open Settings</string>
    <!-- Intro sentence under the top bar of the notification settings screen. Two lines. -->
    <string name="notification_settings_intro">Configure your notification preferences to stay updated with your favorite launches!</string>
    <!-- Title of a switch. When on, the user gets a notification for every launch. One line. -->
    <string name="notification_settings_follow_all_title">Follow All Launches</string>
    <!-- Description under the Follow All Launches switch. One or two lines. -->
    <string name="notification_settings_follow_all_description">Get notified for every launch across all agencies and locations</string>
    <!-- Note shown when Follow All Launches is on. Tells the user the agency and location choices below are ignored. Two lines. -->
    <string name="notification_settings_follow_all_override_note">You\'re following all launches! Individual selections below are overridden.</string>
    <!-- Section heading above the strict matching switch. One line. -->
    <string name="notification_settings_matching_title">Notification Matching</string>
    <!-- Description under the Notification Matching heading. One or two lines. -->
    <string name="notification_settings_matching_description">Control how your selected agencies and locations work together</string>
    <!-- Title of a switch. When on, a launch must match both an agency and a location. One line. -->
    <string name="notification_settings_strict_matching_title">Strict Matching</string>
    <!-- Note under the Strict Matching switch when Follow All Launches is on. One or two lines. -->
    <string name="notification_settings_matching_not_applicable">Not applicable when following all launches</string>
    <!-- Explains the strict matching mode. STRICT, BOTH and AND are in capitals for emphasis; keep the emphasis. Two lines. -->
    <string name="notification_settings_strict_summary">STRICT: Show launches that match BOTH agency AND location</string>
    <!-- Example for strict matching. SpaceX and Kennedy Space Center are proper names. KSC is the short form of Kennedy Space Center. ONLY is in capitals for emphasis. Two or three lines. -->
    <string name="notification_settings_strict_example">Example: If you select SpaceX + Kennedy Space Center, you\'ll ONLY get SpaceX launches from KSC.</string>
    <!-- Three bullet lines under the strict matching example. Each line starts with a bullet, a check or cross emoji. Keep the emoji and the line breaks. KSC is the short form of Kennedy Space Center. -->
    <string name="notification_settings_strict_bullets">• ✅ SpaceX from KSC\n• ❌ SpaceX from other locations\n• ❌ Other agencies from KSC</string>
    <!-- Explains the flexible matching mode. FLEXIBLE, ANY and OR are in capitals for emphasis; keep the emphasis. Two lines. -->
    <string name="notification_settings_flexible_summary">FLEXIBLE: Show launches that match ANY agency OR location</string>
    <!-- Example for flexible matching. SpaceX and Kennedy Space Center are proper names. KSC is the short form of Kennedy Space Center. ALL and AND are in capitals for emphasis. Two or three lines. -->
    <string name="notification_settings_flexible_example">Example: If you select SpaceX + Kennedy Space Center, you\'ll get ALL SpaceX launches AND all KSC launches.</string>
    <!-- Three bullet lines under the flexible matching example. Each line starts with a bullet and a check emoji. Keep the emoji and the line breaks. KSC is the short form of Kennedy Space Center. -->
    <string name="notification_settings_flexible_bullets">• ✅ SpaceX from anywhere\n• ✅ Any agency from KSC\n• ✅ Much more notifications</string>
    <!-- Section heading above the list of agency checkboxes. One line. -->
    <string name="notification_settings_providers_title">Launch Service Providers</string>
    <!-- Description under the Launch Service Providers heading. One line. -->
    <string name="notification_settings_providers_description">Select which launch providers to follow</string>
    <!-- Title of a switch. When on, Starlink launches send no notification. Starlink is a product name. One line. -->
    <string name="notification_settings_mute_starlink_title">Mute Starlink launches</string>
    <!-- Description under the Mute Starlink launches switch. Starlink is a product name. One or two lines. -->
    <string name="notification_settings_mute_starlink_description">You\'ll still be notified if a Starlink launch fails.</string>
    <!-- Section heading above the list of location checkboxes. One line. -->
    <string name="notification_settings_locations_title">Launch Locations</string>
    <!-- Description under the Launch Locations heading. One line. -->
    <string name="notification_settings_locations_description">Select which locations to follow</string>
    <!-- Title of the premium upsell card. One or two lines. -->
    <string name="notification_settings_premium_title">Unlock Notification Customization</string>
    <!-- Body of the premium upsell card. Premium is the name of the paid plan. Two lines. -->
    <string name="notification_settings_premium_description">Upgrade to Premium to customize your notification preferences.</string>
    <!-- Section heading above the list of topic switches. One line. -->
    <string name="notification_settings_topics_title">Notification Topics</string>
    <!-- Sub-heading above the event, news and announcement switches. One line. -->
    <string name="notification_settings_general_title">General Notifications</string>
