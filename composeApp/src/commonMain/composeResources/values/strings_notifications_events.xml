    <string name="schedule_filter_sheet_title">Filter Launches</string>
    <!-- Content description of the close icon button on the filter sheet. Read by screen readers. -->
    <string name="schedule_filter_close">Close</string>
    <!-- Button on the filter sheet and the reload dialog. Dismisses without changes. One word, max 14 chars. -->
    <string name="schedule_filter_cancel">Cancel</string>
    <!-- Button on the filter sheet when no filter is selected. Applies the filters. One word, max 14 chars. -->
    <string name="schedule_filter_apply">Apply</string>
    <!-- Title of the confirm dialog opened by the reload button on the filter sheet. A question. One line. -->
    <string name="schedule_filter_reload_title">Reload Filter Options?</string>
    <!-- Body of the reload confirm dialog. Several lines. -->
    <string name="schedule_filter_reload_message">This will re-download all filter options from the server. This may take a few moments and will refresh the list of agencies, programs, rockets, locations, and statuses.</string>
    <!-- Confirm button of the reload dialog. One word, max 14 chars. -->
    <string name="schedule_filter_reload_confirm">Reload</string>
    <!-- Button at the bottom of the filter sheet. Opens the reload confirm dialog. One line. -->
    <string name="schedule_filter_reload_button">Reload Filter Options</string>
    <!-- Small button on the filter sheet next to the active filter count. Removes every selected filter. Max 14 chars. -->
    <string name="schedule_filter_clear_all">Clear All</string>
    <!-- Info note at the top of the filter sheet, shown next to an info icon. Two or three lines. Home page and Schedule are screen names. -->
    <string name="schedule_filter_scope_note">These filters only affect the Schedule screen. They won\'t change what appears on the Home page or in notifications.</string>
    <!-- Banner text on the filter sheet. Starts with a construction emoji; keep it. One line. -->
    <string name="schedule_filter_work_in_progress">🚧 Work In Progress</string>
    <!-- Section heading on the filter sheet, above the crewed-only switch. One line. -->
    <string name="schedule_filter_launch_type_heading">Launch Type Filters</string>
    <!-- Label of a switch on the filter sheet. When on, only crewed launches show. One line. -->
    <string name="schedule_filter_crewed_only">Crewed Launches Only</string>
    <!-- Filter section heading on the filter sheet. Space agencies and launch providers. One line. -->
    <string name="schedule_filter_agencies">Agencies</string>
    <!-- Filter section heading on the filter sheet. Space programs. One line. -->
    <string name="schedule_filter_programs">Programs</string>
    <!-- Filter section heading on the filter sheet. Rocket types. One line. -->
    <string name="schedule_filter_rockets">Rockets</string>
    <!-- Warning under the Rockets filter when more than one rocket is selected. API is a technical term. One or two lines. -->
    <string name="schedule_filter_rocket_limit_note">Note: API supports only 1 rocket filter. Only the first selection will be applied.</string>
    <!-- Filter section heading on the filter sheet. Launch sites. One line. -->
    <string name="schedule_filter_locations">Locations</string>
    <!-- Filter section heading on the filter sheet. Launch statuses such as Go or Hold. One line. -->
    <string name="schedule_filter_statuses">Statuses</string>
    <!-- Filter section heading on the filter sheet. Target orbits. One line. -->
    <string name="schedule_filter_orbits">Orbits</string>
    <!-- Filter section heading on the filter sheet. Types of mission such as Communications. One line. -->
    <string name="schedule_filter_mission_types">Mission Types</string>
    <!-- Filter section heading on the filter sheet. Rocket families such as Falcon. One line. -->
    <string name="schedule_filter_launcher_families">Launcher Families</string>
    <!-- Content description of the small X icon on a selected filter chip. Removes that filter. Read by screen readers. -->
    <string name="schedule_filter_remove">Remove filter</string>
    <!-- Placeholder in a filter dropdown field when nothing is selected. One line. Keep the three dots. -->
    <string name="schedule_filter_select_options">Select options...</string>
    <!-- Content description of the dropdown arrow when the list is open. Read by screen readers. -->
    <string name="schedule_filter_collapse">Collapse</string>
    <!-- Content description of the dropdown arrow when the list is closed. Read by screen readers. -->
    <string name="schedule_filter_expand">Expand</string>
    <!-- Disabled item in a filter dropdown when the typed search matches nothing. One line. -->
    <string name="schedule_filter_no_results">No results found</string>
    <!-- Content description of the check mark beside a selected filter option. Read by screen readers. -->
    <string name="schedule_filter_selected_description">Selected</string>
    <!-- Launch name in a list card when the launch has no name. Short. -->
    <string name="schedule_launch_unknown_name">Unknown Launch</string>
    <!-- Launch site in a list card when the launch has no location. Short. -->
    <string name="schedule_launch_unknown_location">Unknown Location</string>
    <!-- Content description of the rocket icon shown when a launch image is missing. Read by screen readers. -->
    <string name="schedule_launch_image_placeholder">placeholder</string>
