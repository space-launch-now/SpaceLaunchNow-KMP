    <string name="notification_settings_event_title">Event Notifications</string>
    <!-- Description under the Event Notifications switch. One or two lines. -->
    <string name="notification_settings_event_description">Space events like spacewalks and dockings</string>
    <!-- Title of a switch for featured news notifications. One line. -->
    <string name="notification_settings_news_title">Featured News</string>
    <!-- Description under the Featured News switch. One line. -->
    <string name="notification_settings_news_description">Curated space news articles</string>
    <!-- Title of a switch for app announcement notifications. One line. -->
    <string name="notification_settings_announcements_title">Announcements</string>
    <!-- Description under the Announcements switch. Space Launch Now is the app name; do not translate. One or two lines. -->
    <string name="notification_settings_announcements_description">Announcements and special messages from Space Launch Now</string>
    <!-- Sub-heading above the timed countdown switches. One line. -->
    <string name="notification_settings_countdown_title">Countdown Notifications</string>
    <!-- Description under the Countdown Notifications sub-heading. One or two lines. -->
    <string name="notification_settings_countdown_description">Get notified at specific times before launch</string>
    <!-- Title of a switch for notifications sent when the launch time changes. NET means No Earlier Than. One line. -->
    <string name="notification_settings_net_change_title">Net Timestamp Changes</string>
    <!-- Description under the Net Timestamp Changes switch. One line. -->
    <string name="notification_settings_net_change_description">When launch times are updated</string>
    <!-- Title of a switch for a notification sent 24 hours before launch. One line. -->
    <string name="notification_settings_notice_24h_title">24 Hour Notice</string>
    <!-- Description under the 24 Hour Notice switch. One line. -->
    <string name="notification_settings_notice_24h_description">24 hours before launch</string>
    <!-- Title of a switch for a notification sent 1 hour before launch. One line. -->
    <string name="notification_settings_notice_1h_title">1 Hour Notice</string>
    <!-- Description under the 1 Hour Notice switch. One line. -->
    <string name="notification_settings_notice_1h_description">1 hour before launch</string>
    <!-- Title of a switch for a notification sent 10 minutes before launch. One line. -->
    <string name="notification_settings_notice_10m_title">10 Minutes Notice</string>
    <!-- Description under the 10 Minutes Notice switch. One line. -->
    <string name="notification_settings_notice_10m_description">10 minutes before launch</string>
    <!-- Title of a switch for a notification sent 1 minute before launch. One line. -->
    <string name="notification_settings_notice_1m_title">1 Minute Notice</string>
    <!-- Description under the 1 Minute Notice switch. Light, friendly tone. One line. -->
    <string name="notification_settings_notice_1m_description">1 minute before launch - for the most dedicated!</string>
    <!-- Sub-heading above the launch status switches. One line. -->
    <string name="notification_settings_status_title">Status Notifications</string>
    <!-- Description under the Status Notifications sub-heading. One or two lines. -->
    <string name="notification_settings_status_description">Stay updated on launch progress and outcomes</string>
    <!-- Title of a switch. When on, only launches that have a live video stream send notifications. One line. -->
    <string name="notification_settings_webcast_title">Webcast Only Launches</string>
    <!-- Description under the Webcast Only Launches switch. One line. -->
    <string name="notification_settings_webcast_description">Launches that have live video streams</string>
    <!-- Title of a switch for notifications sent while a rocket is flying. One line. -->
    <string name="notification_settings_in_flight_title">In-Flight Updates</string>
    <!-- Description under the In-Flight Updates switch. One line. -->
    <string name="notification_settings_in_flight_description">Real-time updates during launch</string>
    <!-- Title of a switch for notifications sent when a mission succeeds. One line. -->
    <string name="notification_settings_mission_success_title">Mission Success</string>
    <!-- Description under the Mission Success switch. Light, friendly tone. One line. -->
    <string name="notification_settings_mission_success_description">Celebrate successful launches!</string>
