<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rocket list top bar title when filters are active. %1$d is the number of matching rockets. One line. -->
    <string name="rockets_list_title_filtered">Rockets (%1$d)</string>
    <!-- Content description of the filter icon button in the rocket list top bar. Read by screen readers. -->
    <string name="rockets_list_filter_description">Filter rockets</string>
    <!-- Text under the spinner while the rocket list loads the first time. One line. -->
    <string name="rockets_list_loading">Loading rockets...</string>
    <!-- Heading of the rocket list error state, above the error message. One or two lines, bold. -->
    <string name="rockets_list_error_title">Failed to load rockets</string>
    <!-- Heading of the empty rocket list, above the hint. One or two lines, bold. -->
    <string name="rockets_list_empty_title">No rockets found</string>
    <!-- Content description of a rocket picture in the list. %1$s is the rocket name. Read by screen readers. -->
    <string name="rockets_list_item_image_description">%1$s image</string>

    <!-- Card heading on the rocket detail screen, above the basic facts. One line, bold. -->
    <string name="rockets_detail_info_title">Rocket Information</string>
    <!-- Card heading on the rocket detail screen, above size and thrust rows. One line, bold. -->
    <string name="rockets_detail_performance_title">Performance</string>
    <!-- Card heading on the rocket detail screen, above the orbit payload rows. One line, bold. -->
    <string name="rockets_detail_capacity_title">Payload Capacity</string>
    <!-- Row label format on the rocket detail screen. %1$s is the row label, such as Length. Keep the colon style of the language. -->
    <string name="rockets_detail_label_format">%1$s:</string>
    <!-- Row label, left column. The rocket full name is the value. -->
    <string name="rockets_detail_label_full_name">Full Name</string>
    <!-- Row value, range of stages. %1$d is the fewest stages, %2$d the most stages. Example: 1-2. -->
    <string name="rockets_detail_stages_range">%1$d-%2$d</string>
    <!-- Row label, left column. The thrust at liftoff is the value. -->
    <string name="rockets_detail_label_liftoff_thrust">Liftoff Thrust</string>
    <!-- Row value, thrust in kilonewtons. %1$s is a formatted number such as 7607. -->
    <string name="rockets_detail_value_kilonewtons">%1$s kN</string>
    <!-- Row value, cost in millions of US dollars. %1$s is a formatted number such as 67. Keep the dollar sign and the M. -->
    <string name="rockets_detail_value_cost_millions">$%1$sM</string>
    <!-- Row label, left column. The number of launches is the value. -->
    <string name="rockets_detail_label_total_launches">Total Launches</string>
    <!-- Row label, left column. The count of launches not flown yet is the value. -->
    <string name="rockets_detail_label_pending">Pending</string>
    <!-- Row label, left column, on the launch and the landing cards. The count of successes in a row is the value. -->
    <string name="rockets_detail_label_consecutive_successes">Consecutive Successes</string>

    <!-- Floating label of the search field in the filter sheet. One line. -->
    <string name="rockets_filter_search_label">Rocket Name</string>
    <!-- Placeholder of the search field in the filter sheet. Example rocket names. One line. -->
    <string name="rockets_filter_search_placeholder">e.g., Falcon, Atlas, Starship</string>
    <!-- Label above the active status segmented buttons. One line. -->
    <string name="rockets_filter_active_title">Active Status</string>
    <!-- Segmented button. No filter on this setting. One word, max 12 chars. -->
    <string name="rockets_filter_option_all">All</string>
    <!-- Segmented button. Shows rockets in service only. Max 12 chars. -->
    <string name="rockets_filter_active_only">Active Only</string>
    <!-- Segmented button. Shows rockets out of service only. One word, max 12 chars. -->
    <string name="rockets_filter_retired">Retired</string>
    <!-- Label above the reusable segmented buttons. One line. -->
    <string name="rockets_filter_reusable_title">Reusability</string>
    <!-- Small text in the filter sheet while the program and family lists load. One line. -->
    <string name="rockets_filter_loading">Loading filter options...</string>
    <!-- Small text in the filter sheet when the program and family lists are empty. One line. -->
    <string name="rockets_filter_none_loaded">No filter options loaded</string>
    <!-- Text button under the empty-options message. Loads the lists again. One line. -->
    <string name="rockets_filter_reload">Reload Options</string>
    <!-- Text button at the end of the filter section. Loads the lists again. One line. -->
    <string name="rockets_filter_refresh">Refresh Filter Options</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_family_asc">Family (A-Z)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_family_desc">Family (Z-A)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_leo_capacity_asc">LEO Capacity (Low to High)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_leo_capacity_desc">LEO Capacity (High to Low)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_gto_capacity_asc">GTO Capacity (Low to High)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_gto_capacity_desc">GTO Capacity (High to Low)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_launch_mass_asc">Launch Mass (Low to High)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_launch_mass_desc">Launch Mass (High to Low)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_launch_cost_asc">Launch Cost (Low to High)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_launch_cost_desc">Launch Cost (High to Low)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_maiden_flight_asc">Maiden Flight (Oldest)</string>
    <!-- Sort option in the rocket filter sheet menu. The text in brackets says the direction. One line. -->
    <string name="rockets_sort_maiden_flight_desc">Maiden Flight (Newest)</string>
    <!-- Sort option in the rocket sort menu. Short phrase, one line. -->
    <string name="rockets_sort_field_total_launches_desc">Most Launches</string>
    <!-- Sort option in the rocket sort menu. Short phrase, one line. -->
    <string name="rockets_sort_field_total_launches_asc">Fewest Launches</string>
    <!-- Sort option in the rocket sort menu. Short phrase, one line. -->
    <string name="rockets_sort_field_first_flight_desc">Newest First</string>
    <!-- Sort option in the rocket sort menu. Short phrase, one line. -->
    <string name="rockets_sort_field_first_flight_asc">Oldest First</string>
</resources>
