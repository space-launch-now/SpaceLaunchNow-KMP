<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch time, one line. %1$s is a clock time such as 2:30 PM. Today's launches. -->
    <string name="time_today_at">Today at %1$s</string>
    <!-- Launch time, one line. %1$s is a clock time such as 2:30 PM. Tomorrow's launches. -->
    <string name="time_tomorrow_at">Tomorrow at %1$s</string>
    <!-- Launch time, one line. %1$s is a clock time such as 2:30 PM. Yesterday's launches. -->
    <string name="time_yesterday_at">Yesterday at %1$s</string>
    <!-- Launch time, one line. %1$s is a weekday name (Monday to Sunday), %2$s a clock time such as 2:30 PM. -->
    <string name="time_weekday_at">%1$s at %2$s</string>
    <!-- Weekday name, full form. Capitalised as at the start of a line. -->
    <string name="time_weekday_monday">Monday</string>
    <!-- Weekday name, full form. Capitalised as at the start of a line. -->
    <string name="time_weekday_tuesday">Tuesday</string>
    <!-- Weekday name, full form. Capitalised as at the start of a line. -->
    <string name="time_weekday_wednesday">Wednesday</string>
    <!-- Weekday name, full form. Capitalised as at the start of a line. -->
    <string name="time_weekday_thursday">Thursday</string>
    <!-- Weekday name, full form. Capitalised as at the start of a line. -->
    <string name="time_weekday_friday">Friday</string>
    <!-- Weekday name, full form. Capitalised as at the start of a line. -->
    <string name="time_weekday_saturday">Saturday</string>
    <!-- Weekday name, full form. Capitalised as at the start of a line. -->
    <string name="time_weekday_sunday">Sunday</string>

    <!-- Launch date when no date is known yet. Short, one word or an abbreviation. "To be determined". -->
    <string name="time_tbd">TBD</string>
    <!-- Launch date with first-half-of-year precision. %1$s is the four-digit year. H1 = first half. Keep short. -->
    <string name="time_half_1_year">H1 %1$s</string>
    <!-- Launch date with second-half-of-year precision. %1$s is the four-digit year. H2 = second half. Keep short. -->
    <string name="time_half_2_year">H2 %1$s</string>
    <!-- Launch date with no earlier date than the year. %1$s is the four-digit year. NET = "no earlier than" (a term of the data field). Keep short. -->
    <string name="time_net_year">NET %1$s</string>
    <!-- Launch date with fiscal-year precision. %1$s is the four-digit year. FY = fiscal year. Keep short. -->
    <string name="time_fiscal_year">FY %1$s</string>
    <!-- Launch date with decade precision. %1$s is the year that starts the decade. -->
    <string name="time_decade_year">Decade %1$s</string>
    <!-- Launch date with quarter precision. %1$d is the quarter number 1 to 4, %2$s the four-digit year. Q = quarter. Keep short. -->
    <string name="time_quarter_year">Q%1$d %2$s</string>

    <!-- Countdown to launch, one line. Starts the compact timer before the launch. %1$s is the time parts, e.g. 1d 06h 59m 59s. T = time of launch. -->
    <string name="time_compact_before">T- %1$s</string>
    <!-- Countdown after launch, one line. Starts the compact timer after the launch. %1$s is the time parts, e.g. 1d 06h 59m 59s. T = time of launch. -->
    <string name="time_compact_after">T+ %1$s</string>
    <!-- Timeline event time before launch. %1$s is the time parts, e.g. 1d 14h. T = time of launch. -->
    <string name="time_timeline_before">T - %1$s</string>
    <!-- Timeline event time after launch. %1$s is the time parts, e.g. 2h 30m. T = time of launch. -->
    <string name="time_timeline_after">T + %1$s</string>

    <!-- Unit suffix for days after a number. %1$s is the number. One letter or short; keep the number first or last as the language needs. -->
    <string name="time_unit_days">%1$sd</string>
    <!-- Unit suffix for hours after a number. %1$s is the number, may start with a zero. One letter or short. -->
    <string name="time_unit_hours">%1$sh</string>
    <!-- Unit suffix for minutes after a number. %1$s is the number, may start with a zero. One letter or short. -->
    <string name="time_unit_minutes">%1$sm</string>
    <!-- Unit suffix for seconds after a number. %1$s is the number, may start with a zero. One letter or short. -->
    <string name="time_unit_seconds">%1$ss</string>

    <!-- Label under the days digits of the countdown. One word, capitals, max 10 chars; the digit row is narrow. -->
    <string name="countdown_label_days">DAYS</string>
    <!-- Label under the hours digits of the countdown. One word, capitals, max 10 chars; the digit row is narrow. -->
    <string name="countdown_label_hours">HOURS</string>
    <!-- Label under the minutes digits of the countdown. One word, capitals, max 10 chars; the digit row is narrow. -->
    <string name="countdown_label_minutes">MINUTES</string>
    <!-- Label under the seconds digits of the countdown. One word, capitals, max 10 chars; the digit row is narrow. -->
    <string name="countdown_label_seconds">SECONDS</string>
    <!-- Lead-in above a large clock time on the launch detail card; the time shows on the next line. Launches today. Ends with the word for "at". -->
    <string name="time_today_at_lead">Today at</string>
    <!-- Lead-in above a large clock time on the launch detail card; the time shows on the next line. Launches tomorrow. -->
    <string name="time_tomorrow_at_lead">Tomorrow at</string>
    <!-- Lead-in above a large clock time on the launch detail card; the time shows on the next line. Launches yesterday. -->
    <string name="time_yesterday_at_lead">Yesterday at</string>
    <!-- Lead-in above a large clock time on the launch detail card; the time shows on the next line. %1$s is a weekday name (Monday to Sunday). -->
    <string name="time_weekday_at_lead">%1$s at</string>
</resources>
