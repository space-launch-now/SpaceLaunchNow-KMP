-- Launch table for caching launch data
-- Stores the serialized JSON for flexibility with API changes.
-- json_data columns hold a JSON envelope around the domain `Launch` model (see
-- LaunchLocalDataSource.CachedLaunchEnvelope / ADR-0004: docs/architecture/adr/
-- 0004-cache-schema-versioning.md), not the old LL API models the column comments below
-- still name historically.

CREATE TABLE LaunchBasicCache (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    status_id INTEGER,
    status_name TEXT,
    net INTEGER, -- stored as epoch milliseconds
    window_end INTEGER, -- stored as epoch milliseconds
    window_start INTEGER, -- stored as epoch milliseconds
    launch_service_provider_id INTEGER,
    launch_service_provider_name TEXT,
    rocket_configuration_id INTEGER,
    rocket_configuration_name TEXT,
    pad_name TEXT,
    location_name TEXT,
    image_url TEXT,
    json_data TEXT NOT NULL, -- Full serialized LaunchBasic object
    cached_at INTEGER NOT NULL, -- Timestamp when cached
    expires_at INTEGER NOT NULL -- Timestamp when cache expires
);

CREATE TABLE LaunchNormalCache (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    status_id INTEGER,
    status_name TEXT,
    net INTEGER, -- stored as epoch milliseconds
    window_end INTEGER, -- stored as epoch milliseconds
    window_start INTEGER, -- stored as epoch milliseconds
    launch_service_provider_id INTEGER,
    launch_service_provider_name TEXT,
    rocket_configuration_id INTEGER,
    rocket_configuration_name TEXT,
    pad_name TEXT,
    location_name TEXT,
    image_url TEXT,
    mission_name TEXT,
    mission_description TEXT,
    json_data TEXT NOT NULL, -- Full serialized LaunchNormal object
    cached_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

CREATE TABLE LaunchDetailedCache (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    status_id INTEGER,
    status_name TEXT,
    net INTEGER,
    window_end INTEGER,
    window_start INTEGER,
    launch_service_provider_id INTEGER,
    launch_service_provider_name TEXT,
    rocket_configuration_id INTEGER,
    rocket_configuration_name TEXT,
    pad_name TEXT,
    location_name TEXT,
    image_url TEXT,
    mission_name TEXT,
    mission_description TEXT,
    json_data TEXT NOT NULL, -- Full serialized LaunchDetailed object
    cached_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

-- Separate cache table for Starship history to prevent cache pollution
CREATE TABLE StarshipHistoryCache (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    status_id INTEGER,
    status_name TEXT,
    net INTEGER, -- stored as epoch milliseconds
    window_end INTEGER,
    window_start INTEGER,
    launch_service_provider_id INTEGER,
    launch_service_provider_name TEXT,
    rocket_configuration_id INTEGER,
    rocket_configuration_name TEXT,
    pad_name TEXT,
    location_name TEXT,
    image_url TEXT,
    mission_name TEXT,
    mission_description TEXT,
    json_data TEXT NOT NULL, -- Full serialized LaunchNormal object
    cached_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

-- Indexes for common queries
CREATE INDEX idx_launch_basic_net ON LaunchBasicCache(net);
CREATE INDEX idx_launch_basic_status ON LaunchBasicCache(status_id);
CREATE INDEX idx_launch_basic_expires ON LaunchBasicCache(expires_at);
CREATE INDEX idx_launch_normal_net ON LaunchNormalCache(net);
CREATE INDEX idx_launch_normal_status ON LaunchNormalCache(status_id);
CREATE INDEX idx_launch_normal_expires ON LaunchNormalCache(expires_at);
CREATE INDEX idx_launch_detailed_expires ON LaunchDetailedCache(expires_at);
CREATE INDEX idx_starship_history_net ON StarshipHistoryCache(net);
CREATE INDEX idx_starship_history_expires ON StarshipHistoryCache(expires_at);

-- LaunchBasicCache (table + indexes above) has no active queries. It backed a "mini" LL
-- tier that was already dead code (zero callers) before the phase5-launch domain-model cache
-- migration; its query wrappers are removed here as part of that cleanup. The CREATE
-- TABLE/INDEX statements are deliberately left untouched (unlike the query blocks below,
-- they're part of the SQLDelight-versioned schema, and removing them would require a
-- migration + a `sqldelight { databases { ... version = ... } }` bump in build.gradle.kts,
-- which is out of scope for this unit) - the table just sits unused on disk.

-- Queries for LaunchNormal (list-sourced launches: upcoming/previous/featured/in-flight/etc.
-- - anything that came from a list-endpoint fetch rather than a single-launch detail fetch).
-- json_data now holds a JSON-encoded envelope around the domain `Launch` model (see
-- LaunchLocalDataSource.CachedLaunchEnvelope / ADR-0004), not an LL API model.
insertOrReplaceNormal:
INSERT OR REPLACE INTO LaunchNormalCache (
    id, name, status_id, status_name, net, window_end, window_start,
    launch_service_provider_id, launch_service_provider_name,
    rocket_configuration_id, rocket_configuration_name,
    pad_name, location_name, image_url, mission_name, mission_description,
    json_data, cached_at, expires_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getNormalById:
SELECT * FROM LaunchNormalCache 
WHERE id = ? AND expires_at > ?;

getUpcomingNormal:
SELECT * FROM LaunchNormalCache 
WHERE net > ? AND expires_at > ?
ORDER BY net ASC
LIMIT ?;

getUpcomingNormalStale:
SELECT * FROM LaunchNormalCache 
WHERE net > ?
ORDER BY net ASC
LIMIT ?;

getPreviousNormal:
SELECT * FROM LaunchNormalCache 
WHERE net < ? AND expires_at > ?
ORDER BY net DESC
LIMIT ?;

getPreviousNormalStale:
SELECT * FROM LaunchNormalCache 
WHERE net < ?
ORDER BY net DESC
LIMIT ?;

deleteExpiredNormal:
DELETE FROM LaunchNormalCache WHERE expires_at < ?;

deleteNormalById:
DELETE FROM LaunchNormalCache WHERE id = ?;

clearAllNormal:
DELETE FROM LaunchNormalCache;

-- Queries for LaunchDetailed
insertOrReplaceDetailed:
INSERT OR REPLACE INTO LaunchDetailedCache (
    id, name, status_id, status_name, net, window_end, window_start,
    launch_service_provider_id, launch_service_provider_name,
    rocket_configuration_id, rocket_configuration_name,
    pad_name, location_name, image_url, mission_name, mission_description,
    json_data, cached_at, expires_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getDetailedById:
SELECT * FROM LaunchDetailedCache 
WHERE id = ? AND expires_at > ?;

getDetailedByIdStale:
SELECT * FROM LaunchDetailedCache 
WHERE id = ?;

deleteExpiredDetailed:
DELETE FROM LaunchDetailedCache WHERE expires_at < ?;

deleteDetailedById:
DELETE FROM LaunchDetailedCache WHERE id = ?;

clearAllDetailed:
DELETE FROM LaunchDetailedCache;

-- Queries for StarshipHistoryCache
insertOrReplaceStarshipHistory:
INSERT OR REPLACE INTO StarshipHistoryCache (
    id, name, status_id, status_name, net, window_end, window_start,
    launch_service_provider_id, launch_service_provider_name,
    rocket_configuration_id, rocket_configuration_name,
    pad_name, location_name, image_url, mission_name, mission_description,
    json_data, cached_at, expires_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getStarshipHistory:
SELECT * FROM StarshipHistoryCache
WHERE net < ? AND expires_at > ?
ORDER BY net DESC
LIMIT ?;

getStarshipHistoryStale:
SELECT * FROM StarshipHistoryCache
WHERE net < ?
ORDER BY net DESC
LIMIT ?;

deleteExpiredStarshipHistory:
DELETE FROM StarshipHistoryCache WHERE expires_at < ?;

clearAllStarshipHistory:
DELETE FROM StarshipHistoryCache;

-- Queries for in-flight launches (status_id = 6)
getInFlightNormal:
SELECT * FROM LaunchNormalCache
WHERE status_id = 6 AND expires_at > ?
ORDER BY net ASC
LIMIT ?;

getInFlightNormalStale:
SELECT * FROM LaunchNormalCache
WHERE status_id = 6 AND expires_at > ? - 3600000
ORDER BY net ASC
LIMIT ?;

