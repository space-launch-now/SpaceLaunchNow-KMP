default_platform(:ios)

# Shared App Store Connect API key, consumed by match, upload_to_testflight, etc.
def api_key
  app_store_connect_api_key(
    key_id: ENV["APPLE_API_KEY_ID"],
    issuer_id: ENV["APPLE_API_ISSUER_ID"],
    key_content: ENV["APPLE_API_KEY_CONTENT"],
    is_key_content_base64: true
  )
end

platform :ios do
  desc "Sync code signing certificates and provisioning profiles via Match"
  lane :sync_certificates do
    setup_ci if ENV["CI"]

    match(
      type: "appstore",
      app_identifier: [
        "me.spacelaunchnow.spacelaunchnow",
        "me.spacelaunchnow.spacelaunchnow.NotificationServiceExtension",
        "me.spacelaunchnow.spacelaunchnow.LaunchWidget"
      ],
      readonly: is_ci,
      api_key: api_key
    )
  end

  desc "Initialize Match for the first time (generates and uploads certs — run once)"
  lane :init_certificates do
    setup_ci if ENV["CI"]

    match(
      type: "appstore",
      app_identifier: [
        "me.spacelaunchnow.spacelaunchnow",
        "me.spacelaunchnow.spacelaunchnow.NotificationServiceExtension",
        "me.spacelaunchnow.spacelaunchnow.LaunchWidget"
      ],
      readonly: false,
      api_key: api_key
    )
  end

  desc "Build a signed Release archive and export IPA for App Store"
  lane :build_release do
    version_name = ENV["VERSION_NAME"] or UI.user_error!("VERSION_NAME env var not set")
    build_num    = ENV["BUILD_NUMBER"] or UI.user_error!("BUILD_NUMBER env var not set")

    # Bump version in Info.plist (replaces PlistBuddy in CI workflow)
    set_info_plist_value(
      path: "iosApp/Info.plist",
      key: "CFBundleShortVersionString",
      value: version_name
    )
    set_info_plist_value(
      path: "iosApp/Info.plist",
      key: "CFBundleVersion",
      value: build_num
    )

    sync_certificates

    build_app(
      project: "iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: ENV["RUNNER_TEMP"] || "./build",
      output_name: "SpaceLaunchNow.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["APPLE_TEAM_ID"],
        uploadBitcode: false,
        uploadSymbols: true,
        compileBitcode: false,
        provisioningProfiles: {
          "me.spacelaunchnow.spacelaunchnow" =>
            "match AppStore me.spacelaunchnow.spacelaunchnow",
          "me.spacelaunchnow.spacelaunchnow.NotificationServiceExtension" =>
            "match AppStore me.spacelaunchnow.spacelaunchnow.NotificationServiceExtension",
          "me.spacelaunchnow.spacelaunchnow.LaunchWidget" =>
            "match AppStore me.spacelaunchnow.spacelaunchnow.LaunchWidget"
        }
      }
    )

    # Verify signing identity, bundle ID, entitlements and profile expiry
    verify_build(
      ipa_path: File.join(ENV["RUNNER_TEMP"] || "./build", "SpaceLaunchNow.ipa")
    )
  end

  desc "Upload IPA to TestFlight via App Store Connect API (replaces deprecated altool)"
  lane :upload_testflight do
    upload_to_testflight(
      ipa: File.join(ENV["RUNNER_TEMP"] || "./build", "SpaceLaunchNow.ipa"),
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload dSYM files to Firebase Crashlytics"
  lane :upload_crashlytics_dsyms do
    output_dir = ENV["RUNNER_TEMP"] || "./build"
    dsym_path = File.join(output_dir, "SpaceLaunchNow.app.dSYM.zip")

    # Find the upload-symbols binary from SPM artifacts
    derived_data = File.join(output_dir, "DerivedData")
    upload_symbols = Dir.glob("#{derived_data}/**/upload-symbols").first

    # Fallback: check Xcode default DerivedData location
    unless upload_symbols
      upload_symbols = Dir.glob("#{Dir.home}/Library/Developer/Xcode/DerivedData/**/SourcePackages/artifacts/**/upload-symbols").first
    end

    if upload_symbols && File.exist?(dsym_path)
      sh("#{upload_symbols} -gsp iosApp/GoogleService-Info.plist -p ios #{dsym_path}")
    else
      UI.important("Skipping dSYM upload: upload-symbols=#{upload_symbols}, dsym=#{File.exist?(dsym_path.to_s)}")
    end
  end

  # Task 1216: App Store listing text lives in fastlane/metadata/<locale>/*.txt.
  # Sends text only: no binary, screenshots or version bump. A field with no file is left as it is
  # in App Store Connect. Fields tied to a version (description, keywords, name, subtitle) need an
  # editable version; promotional text can change at any time.
  desc "Upload App Store listing text (name, subtitle, description, keywords, promotional text) from fastlane/metadata"
  lane :upload_metadata do
    deliver(
      api_key: api_key,
      app_identifier: "me.spacelaunchnow.spacelaunchnow",
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  # Task 1216: pulls the live listing text (keywords and promotional text included) into
  # fastlane/metadata_downloaded, so a person can copy the fields into fastlane/metadata.
  # Read only: nothing is sent to App Store Connect.
  desc "Download the live App Store listing text to fastlane/metadata_downloaded"
  lane :download_metadata do
    require "json"
    require "fileutils"
    key_file = File.join(Dir.tmpdir, "asc_api_key.json")
    File.write(key_file, JSON.generate(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_ISSUER_ID"],
      key: ENV["APPLE_API_KEY_CONTENT"],
      is_key_content_base64: true
    ))
    # A lane and its `sh` calls run inside the fastlane folder, so the output path is absolute.
    # A relative "./fastlane/metadata_downloaded" lands in fastlane/fastlane/.
    out_dir = File.expand_path("metadata_downloaded")
    begin
      sh("bundle exec fastlane deliver download_metadata --api_key_path #{key_file} " \
         "--app_identifier me.spacelaunchnow.spacelaunchnow --metadata_path #{out_dir} --force")
    ensure
      File.delete(key_file) if File.exist?(key_file)
      # The review contact (phone, email, demo sign-in) must not reach a build artifact:
      # the repo is public.
      FileUtils.rm_rf(File.join(out_dir, "review_information"))
    end
  end
end
